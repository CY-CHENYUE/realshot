{
  "name": "realshot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RealShot: Snowline, a browser first-person shooter (three.js) that also plays on a transparent-screen box",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "check": "node --check server.mjs && node --input-type=module -e \"import{readdirSync}from'node:fs';import{execFileSync}from'node:child_process';for(const f of readdirSync('src'))if(f.endsWith('.mjs'))execFileSync(process.execPath,['--check','src/'+f],{stdio:'inherit'})\"",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
